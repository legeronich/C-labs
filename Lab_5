#include <iostream>
using namespace std;

int main() {
    int x, count = 0;
    cout << "Введите целые числа (0 - конец ввода): ";
    while (cin >> x && x != 0) {
        if (x > 0 && x % 9 == 0) {
            count++;
        }
    }
    cout << "Количество натуральных чисел, кратных 9: " << count << endl;
    return 0;
}


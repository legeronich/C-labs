#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Введите размер массива: ";
    cin >> n;

    double a[100];
    cout << "Введите элементы массива: ";
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    double minEl = a[0];
    for (int i = 1; i < n; i++) {
        if (a[i] < minEl) {
            minEl = a[i];
        }
    }

    double sum = minEl + a[n - 1];
    cout << "Сумма последнего и минимального элементов: " << sum << endl;
    return 0;
}

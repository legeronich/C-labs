#include <iostream>
#include <cmath>
using namespace std;

int main() {
    double a, b, c, x, F;
    
    cout << "Введіть значення x: ";
    cin >> x;
    cout << "Введіть значення a, b, c: ";
    cin >> a >> b >> c;

    if (x < 0.6 && (b + c != 0)) {
        F = a * pow(x, 3) + pow(b, 2) + c;
    }
   
    else if (x > 0.6 && (b + c == 0)) {
        if (x - c == 0) {
            cout << "Помилка: ділення на нуль (x - c = 0)!\n";
            return 1;
        }
        F = (x - a) / (x - c);
    }

    else {
        if (c == 0 || a == 0) {
            cout << "Помилка: ділення на нуль (знаменники c або a дорівнюють нулю)!\n";
            return 1;
        }
        F = (x / c) + (x / a);
    }

    cout << "Результат: F = " << F << endl;

    return 0;
}

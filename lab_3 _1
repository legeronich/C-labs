#include <iostream>
#include <cmath>
#include <algorithm>
using namespace std;

int main() {
    int a, b, c;
    cout << "Введите три целых числа: ";
    cin >> a >> b >> c;

    cout << "Начальные значения: " << a << " " << b << " " << c << endl;

    int x[] = {a, b, c};
    sort(x, x + 3);

    int d = abs(x[2]) - abs(x[0]);
    double s = (a + b + c) / 3.0;

    cout << "Разница модулей: " << d << endl;
    cout << "Среднее арифметическое: " << s << endl;

    if (d > s) {
        if (a == x[1]) a = b + c;
        else if (b == x[1]) b = a + c;
        else c = a + b;
        cout << "Условие выполнено: среднее число заменено суммой двух других.\n";
    } else cout << "Условие не выполнено: значения не изменены.\n";

    cout << "Конечные значения: " << a << " " << b << " " << c << endl;
    return 0;
}
